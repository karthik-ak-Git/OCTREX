{
  "name": "octrex-code-v4",
  "version": "4.0.0",
  "private": true,
  "description": "OCTREX CODE V4 - Autonomous AI Software Engineering Operating System",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @altrex/desktop dev",
    "dev:web": "pnpm --filter @altrex/desktop dev:web",
    "build": "pnpm -r build",
    "dist:win": "pnpm --filter @altrex/desktop dist:win",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "preview": "pnpm --filter @altrex/desktop preview",
    "smoke": "pnpm --filter @altrex/desktop smoke"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
